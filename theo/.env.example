# /etc/labsrv-theo.env — copiar para /etc/ no host, nunca commitar preenchido

# SbrTask — PostgreSQL direto (mesmo host: Zion VPS)
SBRTASK_DB_URL=postgresql://sbrtask:SENHA@localhost:5432/sbrtask

# Entity exchange (compartilhado com SbrTask)
ENTITY_EXCHANGE_PATH=/tmp/entity_exchange

# Telegram — bot e grupo de negócios do T.H.E.O.
THEO_BOT_TOKEN=
THEO_CHAT_ID=
THEO_TOPIC_ALERTAS=
THEO_TOPIC_XP=
THEO_TOPIC_CICLOS=
THEO_TOPIC_RESUMOS=

# Matrix — grupo inter-entidades (opcional)
MATRIX_CHAT_ID=
MATRIX_TOPIC_MUNDO=

# Notifier
THEO_NOTIFY_ENABLED=true
THEO_NOTIFY_INTERVAL=60
THEO_POLL_INTERVAL=2
THEO_QUIET_START=22
THEO_QUIET_END=7

# Superadmins (IDs do Telegram, vírgula-separados)
THEO_SUPERADMIN_IDS=1030157568
